PROCEDURE shuffle(T t, n) IS
  q, w
IN
  q:=5;
  w:=1;
  FOR i FROM 1 TO n DO
    w:=w*q;
    w:=w%n;
    t[i]:=w;
    WRITE 1111;
    WRITE w;
    WRITE t[i];
  ENDFOR
  t[n]:=0;
END

PROCEDURE write(T t, n) IS
IN
  FOR i FROM 1 TO n DO
    WRITE t[i];
  ENDFOR
END

PROGRAM IS
  t[1:23], n
IN
  n:=23;
  shuffle(t,n);
  WRITE 9999;
  write(t,n);
END
