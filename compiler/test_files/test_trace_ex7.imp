PROGRAM IS
	a, b, c, i, j, k
IN
	a:=0;
	b:=0;
	c:=0;
	i:=111091;
    WRITE 1000;
	WHILE i<=111110 DO
        WRITE 2000;
		j:=209;
		WHILE j>=200 DO
            WRITE 3000;
			k:=11;
			WHILE k<=20 DO
                WRITE 4000;
				a:=a+k;
				k:=k+1;
			ENDWHILE
			b:=b+j;
			j:=j-1;
		ENDWHILE
		c:=c+i;
        i:=i+1;
	ENDWHILE
	WRITE a;
	WRITE b;
	WRITE c;
END
