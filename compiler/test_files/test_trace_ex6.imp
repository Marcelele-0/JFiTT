PROGRAM IS
    f[0:100], s[0:100], i[0:100], n, k, l
IN
    n := 20;
    f[0] := 0;
    s[0] := 1;
    i[0] := 0;
    f[1] := 1;
    s[1] := 1;
    i[1] := 1;
    WRITE 1111;
    WRITE s[0];
    WRITE s[1];
    FOR j FROM 2 TO n DO
        k := j - 1;
        l := k - 1;
	    i[j] := i[k] + 1;
	    f[j] := f[k] + f[l];
        WRITE 2222;
        WRITE s[k];
        WRITE i[j];
        s[j] := s[k] * i[j];
        WRITE s[j];
    ENDFOR
    WRITE 9999;
    WRITE s[n];
    WRITE f[n];
END
